# Copia este archivo a `.env` (o exporta las variables en tu shell).
# Todas son opcionales: sin clave, el proxy usa fuentes gratuitas.

# Clave de HaveIBeenPwned (de pago). Si está, se usa para las brechas;
# si no, se recurre a XposedOrNot (gratis y sin clave).
HIBP_API_KEY=

# Puerto del proxy (por defecto 8787). Debe coincidir con la URL configurada
# en la app (barra de enriquecimiento → ajustes).
PORT=8787
